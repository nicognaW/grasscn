{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/lib/utils": ["../tests/fixtures/renderer/utils.ts"],
      "@/components/ui/*": ["../../apps/web/registry/ui/*"],
      "@tests/*": ["../tests/src/*"],
      "@tests/paths": ["../tests/src/paths.ts"]
    },
    "types": ["bun", "node", "vite/client"],
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mts",
    "src/**/*.mjs",
    "cli/**/*.mjs",
    "fixtures/**/*.ts",
    "fixtures/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "tests/unit/**/*.mjs",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "tests/**/source-input/**",
    "../../test-results",
    "../../.pixel-perfect-test",
    "../../.native-reference"
  ]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/lib/utils": ["./tests/fixture/utils.ts"],
      "@/components/ui/*": ["../../apps/web/registry/ui/*"]
    },
    "types": ["node", "vite/client"],
    "resolveJsonModule": true
  },
  "include": ["tests/**/*.ts", "tests/**/*.tsx", "*.config.ts"]
}

{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "dependsOn": [
        "^generate"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "outputs": [
        "dist/**",
        "public/r/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    },
    "test:unit": {
      "cache": false
    },
    "verify": {
      "cache": false
    },
    "capture": {
      "cache": false
    }
  }
}

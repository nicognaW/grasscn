{
  "name": "grasscn",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "full-tests": "bun scripts/full-run.mjs",
    "dev": "bun scripts/prepare-preview.mjs && bun --bun vite --config vite.preview.config.ts",
    "build": "bun run registry:build && bun --bun vite build --config vite.preview.config.ts",
    "registry:build": "bunx --bun --no-install shadcn build && bun scripts/check-primitives.mjs --built",
    "registry:serve": "bun run registry:build && bun scripts/serve.mjs",
    "test": "bun scripts/prepare-preview.mjs && bun scripts/browser-suite.mjs run",
    "porting:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-porting.ps1 -Suite regressions",
    "check:pr": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-porting.ps1 -Suite all",
    "prepare": "bunx --bun --no-install uncheck prepare --pre-commit"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^6.0.2",
    "@playwright/test": "^1.64.1",
    "@shadcn/lint": "^0.2.3",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "9.3.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "eslint-plugin-github": "^6.1.2",
    "input-otp": "^1.5.0",
    "modern-screenshot": "4.7.0",
    "opentype.js": "^2.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.90.0",
    "oxlint-plugin-react-doctor": "^0.9.21",
    "oxlint-tsgolint": "^7.0.2005",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.15.1",
    "recharts": "3.8.0",
    "shadcn": "4.23.0",
    "shiki": "4.5.0",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "^8.1.0",
    "uncheck": "^0.1.1",
    "vite": "^8.3.5",
    "zod": "^4.6.7",
    "turbo": "2.9.18"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}

{
  "name": "simple-shadcn-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run registry:build && node scripts/serve.mjs",
    "registry:build": "shadcn build",
    "build": "npm run registry:build && npm run preview:build",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:behavior": "playwright test button.spec.ts",
    "test:pixels": "playwright test pixels.spec.ts",
    "reference:capture": "node tests/reference/capture.mjs",
    "assets:generate": "node scripts/generate-assets.mjs",
    "map:check": "node scripts/check-map.mjs",
    "map:list": "node scripts/check-map.mjs --list",
    "reference:controls": "node tests/reference/capture-controls.mjs",
    "test:controls": "playwright test controls.spec.ts",
    "test:slider": "playwright test slider.spec.ts",
    "reference:repeat": "node scripts/verify-reference-repeat.mjs",
    "preview": "node scripts/prepare-preview.mjs && vite --config vite.preview.config.ts",
    "preview:check": "npm run map:check && node scripts/prepare-preview.mjs",
    "preview:build": "npm run preview:check && vite build --config vite.preview.config.ts",
    "preview:sync": "node scripts/sync-preview-site.mjs",
    "test:preview": "playwright test preview.spec.ts",
    "test:input": "playwright test input.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "opentype.js": "^2.0.0",
    "pngjs": "^7.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

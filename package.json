{
  "name": "grasscn",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-preview.mjs && vite --config vite.preview.config.ts",
    "build": "npm run check && npm run registry:build && vite build --config vite.preview.config.ts",
    "registry:build": "shadcn build && node scripts/check-primitives.mjs --built",
    "registry:serve": "npm run registry:build && node scripts/serve.mjs",
    "typecheck": "node scripts/prepare-preview.mjs && tsc --noEmit",
    "test": "node scripts/prepare-preview.mjs && playwright test",
    "check": "npm run typecheck && node scripts/check-primitives.mjs && node scripts/check-registry-closure.mjs && node scripts/check-map.mjs && node scripts/check-porting-evidence.mjs && node --test tests/porting-evidence.test.mjs tests/primitives.test.mjs tests/browser-checkpoints.test.mjs tests/guarded-entry.test.mjs",
    "porting:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-porting.ps1 -Suite regressions",
    "check:pr": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-porting.ps1 -Suite all"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^6.0.2",
    "@playwright/test": "^1.64.1",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "9.3.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "^1.5.0",
    "modern-screenshot": "4.7.0",
    "opentype.js": "^2.0.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.15.1",
    "recharts": "3.8.0",
    "shadcn": "4.23.0",
    "shiki": "4.5.0",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

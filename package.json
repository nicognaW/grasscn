{
  "name": "grasscn",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@grasscn/web",
    "build": "turbo run build",
    "registry:build": "turbo run registry:build",
    "registry:serve": "bun run --filter @grasscn/web registry:serve",
    "test": "bun run --filter @grasscn/tests test",
    "porting:check": "powershell -NoProfile -ExecutionPolicy Bypass -File packages/pixel-perfect/cli/run-porting.ps1 -Suite regressions",
    "check:pr": "powershell -NoProfile -ExecutionPolicy Bypass -File packages/tests/cli/check-pr.ps1",
    "full-tests": "bun run --filter @grasscn/pixel-perfect full-tests",
    "prepare": "bunx --bun --no-install uncheck prepare --pre-commit",
    "test:ppt": "bun run --filter @grasscn/pixel-perfect test"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.3",
    "@types/node": "^26.6.5",
    "eslint-plugin-github": "^6.1.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.90.0",
    "oxlint-plugin-react-doctor": "^0.9.21",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "ultracite": "^8.1.0",
    "uncheck": "0.1.1",
    "turbo": "2.11.10"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "patchedDependencies": {
    "uncheck@0.1.1": "patches/uncheck@0.1.1.patch"
  }
}

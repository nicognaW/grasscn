{
  "name": "grasscn",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run registry:build && node scripts/serve.mjs",
    "registry:build": "shadcn build",
    "build": "npm run registry:build && npm run preview:build",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:behavior": "playwright test button.spec.ts",
    "test:pixels": "playwright test pixels.spec.ts",
    "reference:capture": "node tests/reference/capture.mjs",
    "assets:generate": "node scripts/generate-assets.mjs",
    "map:check": "npm run registry:check && node scripts/check-map.mjs",
    "map:list": "node scripts/check-map.mjs --list",
    "reference:controls": "node tests/reference/capture-controls.mjs",
    "test:controls": "playwright test controls.spec.ts",
    "test:slider": "playwright test slider.spec.ts",
    "reference:repeat": "node scripts/verify-reference-repeat.mjs",
    "preview": "node scripts/prepare-preview.mjs && vite --config vite.preview.config.ts",
    "preview:check": "npm run map:check && node scripts/prepare-preview.mjs",
    "preview:build": "npm run preview:check && vite build --config vite.preview.config.ts",
    "test:preview": "node scripts/prepare-preview.mjs && playwright test preview.spec.ts",
    "test:input": "playwright test input.spec.ts",
    "registry:check": "node scripts/check-registry-closure.mjs",
    "porting:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-porting.ps1 -Suite regressions",
    "porting:pixels": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-porting.ps1 -Suite pixels",
    "check:pr": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-porting.ps1 -Suite all",
    "pretypecheck": "node scripts/prepare-preview.mjs",
    "pretest": "node scripts/prepare-preview.mjs"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^6.0.2",
    "@playwright/test": "^1.64.1",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "9.3.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "^1.5.0",
    "modern-screenshot": "4.7.0",
    "opentype.js": "^2.0.0",
    "pngjs": "^7.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.15.1",
    "recharts": "3.8.0",
    "shadcn": "4.23.0",
    "shiki": "4.5.0",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vaul": "1.1.2",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

{
  "extends": ["//"],
  "tasks": {
    "generate": {
      "inputs": [
        "content/docs/**",
        "source.config.ts",
        "scripts/generate-component-symbols.mjs",
        "registry.json",
        "registry/**/*.ts",
        "registry/**/*.tsx",
        "component-groups.json",
        "package.json",
        "app/**",
        "next.config.mjs",
        "tsconfig.json",
        "$TURBO_ROOT$/packages/pixel-perfect/tests/reference/**/*.json"
      ],
      "outputs": [
        ".source/**",
        ".next/types/routes.d.ts",
        ".next/types/validator.ts",
        ".next/types/root-params.d.ts",
        ".next/types/cache-life.d.ts",
        "next-env.d.ts"
      ]
    },
    "registry:build": {
      "outputs": ["public/r/**"],
      "inputs": ["registry.json", "registry/**", "package.json"]
    },
    "build": {
      "dependsOn": ["generate", "registry:build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/server/route-cache/**"]
    }
  }
}

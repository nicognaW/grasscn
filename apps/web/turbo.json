{
  "extends": [
    "//"
  ],
  "tasks": {
    "generate": {
      "inputs": [
        "content/docs/**",
        "source.config.ts",
        "package.json",
        "app/**",
        "next.config.mjs",
        "tsconfig.json"
      ],
      "outputs": [
        ".source/**",
        ".next/types/**",
        "next-env.d.ts"
      ]
    },
    "registry:build": {
      "outputs": [
        "public/r/**"
      ],
      "inputs": [
        "registry.json",
        "registry/**",
        "package.json"
      ]
    },
    "build": {
      "dependsOn": [
        "generate",
        "registry:build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/types/**"
      ]
    }
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/lib/utils": ["./utils.ts"],
      "@/components/ui/*": ["./registry/ui/*"],
      "@/*": ["./*"],
      "@/components/chart-fps": ["./registry/blocks/chart-fps.tsx"],
      "@/components/chart-profiler": ["./registry/blocks/chart-profiler.tsx"],
      "@/components/chart-analytics": ["./registry/blocks/chart-analytics.tsx"]
    },
    "types": ["node"],
    "resolveJsonModule": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "allowJs": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "mdx-components.tsx",
    "source.config.ts",
    ".source/**/*.ts",
    ".next/types/**/*.ts",
    "registry/**/*.ts",
    "registry/**/*.tsx",
    ".next/dev/types/**/*.ts",
    "examples/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}

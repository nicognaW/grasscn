{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/lib/utils": [
        "./tests/fixture/utils.ts"
      ],
      "@/hooks/use-toast": [
        "./registry/hooks/use-toast.ts"
      ],
      "@/components/ui/*": [
        "./registry/ui/*"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "registry/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "*.config.ts",
    "preview/**/*.ts",
    "preview/**/*.tsx",
    "registry/**/*.ts"
  ]
}
